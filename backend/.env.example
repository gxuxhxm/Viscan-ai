# Viscan AI Backend - Environment Variables
# Copy this file to `.env` and fill in your values. Never commit `.env` to Git.

# Google Gemini API key — powers intent interpretation, dictation structuring
# and contextual follow-up summaries. Leave blank to run in deterministic
# demo mode (no AI calls, fully functional with heuristics).
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use. Model availability varies by Google account/region.
# If you see 404 (model unavailable) or persistent 503 (high demand), pick
# another flash-tier model from your key's model list:
#   GET https://generativelanguage.googleapis.com/v1beta/models?key=KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional legacy provider — used only when GEMINI_API_KEY is blank.
OPENAI_API_KEY=
